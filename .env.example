# 一拍迹合 · 环境配置
# 全部留空也能完整运行（本地景点库 + 规则行程引擎 + 本地旅行助手）。
# 需要 AI 能力时按需填写，填 your-xxx 这样的占位值等同于未配置。

# ---- 大模型（OpenAI 兼容：OpenAI / DeepSeek / 通义千问 / Kimi / 本地 Ollama 均可）----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# chat = Chat Completions（推荐，兼容性最好）；responses = OpenAI Responses API（支持联网搜索）
LLM_WIRE_API=chat
LLM_WEB_SEARCH=live
LLM_WEB_SEARCH_MODEL=gpt-4o-mini-search-preview
LLM_TIMEOUT=45

# ---- 豆包（火山方舟）联网搜索：发现景点 / 解锁上海以外的城市 ----
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# ---- MiMo 语音转写：听抖音视频的语音（不配置时用视频标题/文案提取地点）----
MIMO_API_KEY=
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# ---- 高德地图 ----
# 前端 JS API（留空使用内置演示 Key；正式使用请在高德控制台申请并绑定域名）
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# Web 服务 Key（可选）
AMAP_KEY=

# ---- 服务 ----
FLASK_PORT=8000
# 只在本机访问用 127.0.0.1；需要手机 / 局域网访问改为 0.0.0.0
FLASK_HOST=127.0.0.1
FLASK_DEBUG=0
DB_PATH=instance/luvdazi.db
# 跨域来源（逗号分隔），前后端同域部署无需配置
# CORS_ORIGINS=https://example.com
