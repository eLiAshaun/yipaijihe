# 一拍迹合 · 环境配置
# 全部留空也能完整运行（内置景点库 + 行程引擎 + 本地旅行助手 + 文字识别地点）。
# 只填一个 DEEPSEEK_API_KEY 就能打开：大模型排行程 / 对话、联网搜索任意城市、看视频画面。
# 填 your-xxx 这样的占位值等同于未配置。

# ---- 大模型（默认 DeepSeek；OpenAI 兼容接口，也可以换成 OpenAI / 通义 / Kimi / 本地 Ollama）----
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-flash = DeepSeek-V4.1-Flash：支持看图、1M 上下文
LLM_MODEL=deepseek-flash
# 换成其他服务时填 LLM_API_KEY（优先于 DEEPSEEK_API_KEY），并改 LLM_BASE_URL / LLM_MODEL
LLM_API_KEY=
# 思考模式：off（默认，快 4-5 倍）/ on（更细致，但慢）
LLM_THINKING=off
# 看图：auto（按模型名判断）/ 1 / 0
LLM_VISION=auto
LLM_TIMEOUT=60

# ---- 联网搜索 ----
# auto：有大模型就开启——搜索引擎找最新攻略，大模型归纳地点并注明出处；搜不到时退回大模型自身知识（会标注「未核实」）
# off：关闭，只用内置景点库
WEB_SEARCH=auto
# 豆包（火山方舟）自带联网搜索，配置后优先使用（可选）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# ---- 互联网渠道（选型参照 Agent Reach：https://github.com/Panniantong/agent-reach）----
# Exa 语义搜索（联网搜索的一个来源）与 Jina Reader 读网页（文章链接、攻略全文）都免 Key；填 Key 额度更高
EXA_API_KEY=
JINA_API_KEY=
# 关闭读网页 / 关闭 yt-dlp 视频下载：off
WEB_READER=auto
YTDLP=auto
# B 站 / YouTube 风控（412、要求登录）时：浏览器插件导出 Netscape 格式 cookies.txt，填文件路径
YTDLP_COOKIES=

# ---- 语音转写：听视频里的讲解 ----
# auto：配置了 MIMO_API_KEY 用 MiMo 云端，否则用本地 Whisper（免费，需安装 requirements-video.txt，run.sh 会自动装）
# local / mimo / off
ASR_ENGINE=auto
# 本地模型：tiny / base / small（默认，约 460MB）/ medium / large-v3。首次启动在后台自动下载
ASR_MODEL=small
# 模型存放目录（默认 instance/models）
ASR_MODEL_DIR=
MIMO_API_KEY=
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# ---- 高德地图 ----
# 前端 JS API（留空使用内置演示 Key；正式使用请在高德控制台申请并绑定域名）
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# ---- 服务 ----
FLASK_PORT=8000
# 只在本机访问用 127.0.0.1；需要手机 / 局域网访问改为 0.0.0.0
FLASK_HOST=127.0.0.1
FLASK_DEBUG=0
DB_PATH=instance/luvdazi.db
# 跨域来源（逗号分隔），前后端同域部署无需配置
# CORS_ORIGINS=https://example.com
